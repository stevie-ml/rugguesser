# Required for LLM-based provenance checking (falls back to heuristic if not set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Smithsonian Open Access API key (get free at https://api.data.gov/signup/)
VITE_SMITHSONIAN_API_KEY=your_smithsonian_key_here

# Optional: Europeana API key (get free at https://pro.europeana.eu/page/get-api)
VITE_EUROPEANA_API_KEY=your_europeana_key_here

# Optional: DPLA API key (get free at https://dp.la/info/developers/codex)
VITE_DPLA_API_KEY=your_dpla_key_here
